<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- 品牌主色：墨青。长时间阅读不刺眼，和米白纸面也是暖冷对比 -->
    <color name="brand">#FF2A6A5D</color>
    <!-- 深色主题下 FAB 的底色：比 brand 深一档，保证白字够 4.5:1 -->
    <color name="brand_deep">#FF1B4A40</color>
    <color name="brand_container">#FFCDE7DF</color>
    <color name="brand_on_container">#FF07241E</color>
    <!-- 极浅的品牌底：图标底、引文底、标签底 -->
    <color name="brand_soft">#FFEDF6F2</color>

    <!-- 页面底色：米白而非纯白，降低屏读眩光 -->
    <color name="page_light">#FFF8F5EF</color>
    <color name="page_dark">#FF101312</color>

    <!-- 卡片比页面亮一档：靠「纸白」而不是阴影分层，扁平但不糊 -->
    <color name="card_surface">#FFFFFEFB</color>
    <color name="card_surface_dark">#FF1A1E1C</color>
    <color name="outline_soft">#FFE7E1D5</color>
    <color name="outline_soft_dark">#FF2B302E</color>

    <!-- 中性面：占位封面、内联译文底色 -->
    <color name="surface_variant">#FFEFEAE0</color>
    <color name="surface_variant_dark">#FF272C2A</color>

    <color name="text_primary">#FF16201C</color>
    <color name="text_secondary">#FF6A736E</color>

    <color name="text_primary_dark">#FFE8ECE9</color>
    <color name="text_secondary_dark">#FF9EA8A2</color>

    <!-- 暖金：只用在「引文」和阅读进度这类需要一点温度的地方 -->
    <color name="accent">#FFB4793C</color>

    <!-- 点词高亮与听书逐词高亮的底色 -->
    <color name="highlight_word">#FFF3D98C</color>
    <color name="highlight_sentence">#3389C5B8</color>
</resources>
