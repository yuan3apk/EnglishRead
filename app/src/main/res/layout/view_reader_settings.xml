<?xml version="1.0" encoding="utf-8"?>
<!-- 阅读设置面板：字号、行距、段距、字距、缩进、主题、亮度、段按钮开关。
     整块可滚动：窄屏上不至于把最后一行裁掉。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_s">

        <!-- 字号：A− / 当前值 / A+ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.EnglishRead.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_text_size" />

            <TextView
                android:id="@+id/label_text_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:gravity="end"
                android:minWidth="56dp"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_font_smaller"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:contentDescription="@string/reader_text_smaller"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="A−"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_font_larger"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_s"
                android:contentDescription="@string/reader_text_larger"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="A+"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 行距 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.EnglishRead.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_line_spacing" />

            <TextView
                android:id="@+id/label_line_spacing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:gravity="end"
                android:minWidth="56dp"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_spacing_smaller"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:contentDescription="@string/reader_line_spacing_smaller"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="−"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_spacing_larger"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_s"
                android:contentDescription="@string/reader_line_spacing_larger"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="+"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- 段距：同时决定段与段之间那条「呼出菜单」的缝有多宽 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.EnglishRead.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_para_spacing" />

            <TextView
                android:id="@+id/label_para_spacing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:gravity="end"
                android:minWidth="56dp"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_para_spacing_smaller"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:contentDescription="@string/reader_para_spacing_smaller"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="−"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_para_spacing_larger"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_s"
                android:contentDescription="@string/reader_para_spacing_larger"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="+"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- 字距 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.EnglishRead.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_letter_spacing" />

            <TextView
                android:id="@+id/label_letter_spacing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:gravity="end"
                android:minWidth="56dp"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_letter_spacing_smaller"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:contentDescription="@string/reader_letter_spacing_smaller"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="−"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_letter_spacing_larger"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_s"
                android:contentDescription="@string/reader_letter_spacing_larger"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="+"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- 首行缩进：按「字」算，不是按 dp——字号变了缩进也要跟着变 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.EnglishRead.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_indent" />

            <TextView
                android:id="@+id/label_indent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:gravity="end"
                android:minWidth="56dp"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_indent_smaller"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:contentDescription="@string/reader_indent_smaller"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="−"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_indent_larger"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_s"
                android:contentDescription="@string/reader_indent_larger"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="+"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- 听书：语速档位 + 「点正文暂停」开关 -->
        <TextView
            style="@style/TextAppearance.EnglishRead.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/reader_tts_section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.EnglishRead.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_speech_rate" />

            <TextView
                android:id="@+id/label_speech_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:gravity="end"
                android:minWidth="56dp"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rate_smaller"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:contentDescription="@string/reader_speech_rate_smaller"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="−"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rate_larger"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_s"
                android:contentDescription="@string/reader_speech_rate_larger"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="0dp"
                android:text="+"
                android:textSize="16sp" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_tap_pause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/reader_tap_to_pause"
            android:textSize="14sp" />

        <!-- 主题 -->
        <TextView
            style="@style/TextAppearance.EnglishRead.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/reader_theme" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/theme_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/theme_system"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_theme_system"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/theme_light"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_theme_light"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/theme_dark"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_theme_dark"
                android:textSize="13sp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_marker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/reader_show_marker"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_brightness"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/reader_brightness" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_api_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_open" />

    </LinearLayout>

</ScrollView>
