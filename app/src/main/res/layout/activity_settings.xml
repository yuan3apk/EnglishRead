<?xml version="1.0" encoding="utf-8"?>
<!-- 全局设置：翻译服务三件套 + 隐私提示。整块可滚动，键盘弹起时也不裁。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="@string/settings_title"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_l">

            <TextView
                style="@style/TextAppearance.EnglishRead.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_translation" />

            <!-- 模板：一键填好地址与模型名，用户只需要贴自己的 Key。
                 模型名和地址都会过期（DeepSeek 就把 deepseek-chat 改成了 deepseek-flash），
                 所以填完仍可手改，模板不是硬约束。 -->
            <TextView
                style="@style/TextAppearance.EnglishRead.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_template_hint" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/template_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                app:singleLine="false"
                app:singleSelection="true"
                app:selectionRequired="false" />

            <TextView
                android:id="@+id/template_note"
                style="@style/TextAppearance.EnglishRead.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:alpha="0.8"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="国内直连，便宜，适合段落翻译"
                tools:visibility="visible" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_base_url_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:hint="@string/settings_api_base_url">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_base_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1"
                    tools:text="https://api.deepseek.com" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_api_key_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:hint="@string/settings_api_key"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_model_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:hint="@string/settings_api_model">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    tools:text="deepseek-chat" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 隐私提示不是可选项：段落原文明文出网，用户必须知道 -->
            <TextView
                style="@style/TextAppearance.EnglishRead.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_privacy_hint" />

            <TextView
                android:id="@+id/settings_error"
                style="@style/TextAppearance.EnglishRead.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:text="接口地址必须是 https://"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_save" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
