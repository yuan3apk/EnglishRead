<?xml version="1.0" encoding="utf-8"?>
<!-- 一段。正文 TextView 的 text 永远是纯原文；「段」按钮是兄弟 View，不是字符串。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:layout_marginBottom="@dimen/reader_para_spacing"
    android:orientation="vertical">

    <!-- 上面那条 layout_marginBottom 是「句子之间的空白」，别顺手删掉或挪进子 View：
         长句占满整屏时，正文里每一点几乎都压在一个单词上，没有这条空白就呼不出菜单。
         它必须留在 item 根布局上——不属于任何 item 的矩形，ReaderActivity.hitContent
         才会把它判成「空白」，点了就是呼菜单。挪进子 View 或改成 padding 都会被算成内容。
         这里的 16dp 只是设计态与首帧的默认值，运行时由 ReaderAdapter.applyParaSpacing
         按设置里的「段距」覆盖（所以改档位不需要重进页面）。 -->

    <TextView
        android:id="@+id/para_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/reader_side_margin"
        android:textAppearance="@style/TextAppearance.EnglishRead.ReadBody"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="false"
        tools:text="It was the best of times, it was the worst of times." />

    <!-- 11sp + 次要色 + 右对齐：小到像装订标记，不像章节标题。
         48dp 触摸区靠 ReaderAdapter 里的 TouchDelegate 撑出来，视觉尺寸不变。 -->
    <TextView
        android:id="@+id/btn_translate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/reader_side_margin"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/reader_translate_paragraph"
        android:clickable="true"
        android:focusable="true"
        android:letterSpacing="0.1"
        android:paddingHorizontal="@dimen/space_s"
        android:paddingVertical="2dp"
        android:text="@string/reader_para_marker"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />

    <!-- 内联译文，默认收起；同一段只请求一次，之后只是显隐。
         做成引文块（左侧暖金竖条 + 品牌浅底）：和原文拉开层次，一眼看出哪句是译的。 -->
    <TextView
        android:id="@+id/para_trans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/reader_side_margin"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_quote"
        android:lineSpacingMultiplier="1.45"
        android:paddingStart="12dp"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="@dimen/space_s"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/reader_translation_text_size"
        android:visibility="gone"
        tools:text="这是最好的时代，这是最坏的时代。"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/para_retry"
        style="@style/TextAppearance.EnglishRead.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/reader_side_margin"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/reader_translate_failed"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 请求在飞时的提示，与「重试」互斥；都没有就是默认的安静状态 -->
    <TextView
        android:id="@+id/para_progress"
        style="@style/TextAppearance.EnglishRead.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/reader_side_margin"
        android:layout_marginTop="@dimen/space_xs"
        android:alpha="0.7"
        android:text="@string/reader_translating"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
